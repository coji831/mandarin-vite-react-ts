# ── mandarin-vite-react-ts — Environment Variables Template ─────────────────
# Copy to .env.local and fill in real values. Never commit .env.local.
#
# IaC-managed (see terraform/): Neon, Upstash, GCP, Railway, Vercel.

# ── Database (Neon serverless PostgreSQL) ────────────────────────────────────
# Local dev uses the Neon **dev** branch (parent main) — isolated from prod.
# Get from: Neon Dashboard → pinyin-pal-db → Branches → dev → Connection Details → Pooled
# (or: neonctl connection-string dev --pooled --database-name neondb --project-id withered-king-06089521)
# Paste your local dev-branch pooled URL below (replace this placeholder).
DATABASE_URL="postgres://neondb_owner:password@ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require"

# ── Auth ─────────────────────────────────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="your-access-token-secret-64-char-hex"
JWT_REFRESH_SECRET="your-refresh-token-secret-64-char-hex"

# ── Server ───────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV="development"
FRONTEND_URL="http://localhost:5173"

# ── GCP credentials (service account JSON, single-line) ─────────────────────
# Each SA key from: GCP Console → IAM → Service Accounts → Create Key (JSON)
# Then: cat key.json | jq -c → paste below
GOOGLE_TTS_CREDENTIALS_RAW='{"type":"service_account","project_id":"pinyin-pal-831","private_key":"...","client_email":"tts-service@pinyin-pal-831.iam.gserviceaccount.com"}'
GEMINI_API_CREDENTIALS_RAW='{"type":"service_account","project_id":"pinyin-pal-831","private_key":"...","client_email":"gemini-service@pinyin-pal-831.iam.gserviceaccount.com"}'
GCS_CREDENTIALS_RAW='{"type":"service_account","project_id":"pinyin-pal-831","private_key":"...","client_email":"gcs-storage-service@pinyin-pal-831.iam.gserviceaccount.com"}'

# ── GCS (content & audio storage — critical) ─────────────────────────────────
# Bucket name from: terraform/main.tf → google_storage_bucket.app_data
GCS_BUCKET_NAME="pinyin-pal-data"

# ── Redis (Upstash) ──────────────────────────────────────────────────────────
# Get from: Upstash Console → pinyin-pal-cache → Connect → Redis URL
REDIS_URL="rediss://default:password@your-db.upstash.io:6379"

# Local dev isolates its Redis keyspace from prod (which leaves this unset → "mandarin:").
# read by config/index.ts (redisConfig.keyPrefix)
REDIS_KEY_PREFIX="mandarin:dev:"

# ── Gemini AI ────────────────────────────────────────────────────────────────
GEMINI_MODEL="models/gemini-3.1-flash-lite"
GEMINI_ENDPOINT="https://generativelanguage.googleapis.com/v1beta"

# ── Cache TTL ────────────────────────────────────────────────────────────────
CACHE_TTL_TTS="86400"

