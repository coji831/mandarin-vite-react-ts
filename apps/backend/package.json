{
  "name": "@mandarin/backend",
  "private": true,
  "version": "0.0.0",
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "prisma": {
    "seed": "npx tsx prisma/seed.ts"
  },
  "scripts": {
    "predev": "npm run build --workspace=@mandarin/shared-utils",
    "dev": "tsx watch src/app/index.ts",
    "dev:nest": "tsx watch src/nest/main.ts",
    "prebuild": "npm run build --workspace=@mandarin/shared-utils",
    "start": "node dist/app/index.js",
    "start:nest": "node dist/nest/main.js",
    "build": "tsc -p tsconfig.build.json && node -e \"require('fs').cpSync('src/shared/docs/openapi.yaml', 'dist/shared/docs/openapi.yaml')\"",
    "typecheck": "tsc --noEmit",
    "typecheck:scripts": "tsc --noEmit --project tsconfig.scripts.json",
    "typecheck:prisma": "tsc --noEmit --project tsconfig.prisma.json",
    "lint": "eslint .",
    "test": "vitest run --changed",
    "test:full": "vitest run",
    "test:unit": "vitest run",
    "test:integration": "vitest --config vitest.integration.config.ts",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:db": "vitest run tests/integration/database.test.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:seed": "prisma db seed",
    "script:cleanup-deprecated": "npx tsx scripts/archive/cleanup-deprecated.ts",
    "script:generate-word-content": "npx tsx scripts/generate/generate-word-content.ts",
    "script:generate-char-enrichment": "npx tsx scripts/generate/generate-character-enrichment.ts",
    "script:seed-char-classification": "npx tsx scripts/enrich/seed-character-classification.ts",
    "script:import-cc-cedict": "npx tsx scripts/enrich/import-cc-cedict.ts",
    "script:check-phase": "npx tsx scripts/dev/check-phase-gate.ts",
    "script:unlock-phase2": "npx tsx scripts/dev/unlock-phase2.ts",
    "script:health-check": "npx tsx scripts/verify/health-check.ts",
    "script:gen-hsk": "npx tsx scripts/generate/hsk-words.ts",
    "script:gen-cc-cedict": "npx tsx scripts/generate/cc-cedict-entries.ts",
    "script:gen-mmah": "npx tsx scripts/generate/mmah-entries.ts",
    "script:gen-unihan": "npx tsx scripts/generate/unihan-strokes.ts",
    "script:gen-pinyin-syllables": "npx tsx scripts/generate/pinyin-syllables.ts",
    "script:gen-static": "npx tsx scripts/generate/static-seed-data.ts",
    "script:gen-all": "npx tsx scripts/generate/hsk-words.ts && npx tsx scripts/generate/cc-cedict-entries.ts && npx tsx scripts/generate/mmah-entries.ts && npx tsx scripts/generate/unihan-strokes.ts && npx tsx scripts/generate/pinyin-syllables.ts && npx tsx scripts/generate/static-seed-data.ts",
    "script:enrich-chars": "npx tsx scripts/enrich/build-character-entries.ts",
    "script:enrich-readings": "npx tsx scripts/enrich/build-character-readings.ts",
    "script:enrich-pinyin-mappings": "npx tsx scripts/enrich/build-pinyin-mappings.ts",
    "script:enrich-words": "npx tsx scripts/enrich/build-word-entries.ts",
    "script:enrich-word-chars": "npx tsx scripts/enrich/build-word-character-junction.ts",
    "script:enrich-pinyin-reps": "npx tsx scripts/enrich/build-pinyin-representatives.ts",
    "script:enrich-radicals": "npx tsx scripts/enrich/build-character-radicals.ts",
    "script:enrich-mw-words": "npx tsx scripts/enrich/build-measure-word-words.ts",
    "script:enrich:component-entries": "npx tsx scripts/enrich/build-component-entries.ts",
    "script:enrich:character-components": "npx tsx scripts/enrich/build-character-components.ts",
    "script:enrich-pass-through": "npx tsx scripts/enrich/pass-through.ts",
    "script:enrich-strokes": "npx tsx scripts/enrich/build-stroke-entries.ts",
    "script:enrich-all": "npx tsx scripts/enrich/build-character-entries.ts && npx tsx scripts/enrich/build-character-readings.ts && npx tsx scripts/enrich/build-pinyin-mappings.ts && npx tsx scripts/enrich/build-word-entries.ts && npx tsx scripts/enrich/build-word-character-junction.ts && npx tsx scripts/enrich/build-pinyin-representatives.ts && npx tsx scripts/enrich/build-character-radicals.ts && npx tsx scripts/enrich/build-measure-word-words.ts && npx tsx scripts/enrich/build-component-entries.ts && npx tsx scripts/enrich/build-character-components.ts && npx tsx scripts/enrich/pass-through.ts && npx tsx scripts/enrich/build-stroke-entries.ts",
    "db:enrich": "npx tsx scripts/enrich/import-cc-cedict.ts && npx tsx scripts/enrich/populate-character-enrichment.ts && npx tsx scripts/enrich/populate-character-readings.ts",
    "db:verify": "npx tsx scripts/verify/verify-data-lifecycle.ts",
    "db:verify:deep": "npx tsx scripts/verify/verify-data-lifecycle.ts --deep",
    "db:verify:pipeline": "npx tsx scripts/verify/verify-pipeline.ts",
    "db:verify:pipeline:phase1": "npx tsx scripts/verify/verify-pipeline.ts --phase1",
    "db:verify:pipeline:phase2": "npx tsx scripts/verify/verify-pipeline.ts --phase2",
    "db:verify:pipeline:phase3": "npx tsx scripts/verify/verify-pipeline.ts --phase3",
    "db:checksum": "npx tsx scripts/verify/verify-pipeline.ts --checksum",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset"
  },
  "dependencies": {
    "@google-cloud/storage": "^7.21.0",
    "@google-cloud/text-to-speech": "^6.4.1",
    "@mandarin/shared-constants": "*",
    "@mandarin/shared-types": "*",
    "@mandarin/shared-utils": "*",
    "@nestjs/common": "^11",
    "@nestjs/core": "^11",
    "@nestjs/platform-express": "^11",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "csv-parse": "^6.1.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "google-auth-library": "^10.9.0",
    "ioredis": "^5.11.1",
    "js-yaml": "^4.3.0",
    "jsonwebtoken": "^9.0.3",
    "node-fetch": "^3.3.2",
    "pg": "^8.22.0",
    "prisma": "^7.8.0",
    "reflect-metadata": "^0.2",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^11.0.0"
  },
  "devDependencies": {
    "@nestjs/testing": "^11",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/js-yaml": "^4.0.9",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.7.2",
    "@types/node-fetch": "^3.0.3",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^7.2.0",
    "@types/swagger-ui-express": "^4.1.8",
    "@vitest/ui": "^4.0.18",
    "adm-zip": "^0.6.0",
    "supertest": "^7.2.2",
    "tsx": "^4.22.4",
    "vitest": "^4.1.9"
  }
}
