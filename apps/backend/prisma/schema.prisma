generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                String              @id @default(uuid())
  email             String              @unique
  passwordHash      String
  displayName       String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  deletedAt         DateTime?
  sessions          Session[]
  characterProgress CharacterProgress[]
  wordStudyContext  WordStudyContext[]
  reviewLogs        ReviewLog[]
  readingSessions   ReadingSession[]
  bookmarks         Bookmark[]

  @@index([email])
}

model Session {
  id           String   @id @default(uuid())
  userId       String
  refreshToken String   @unique
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([refreshToken])
}

// ── Deprecated Models Removed (Phase C) ──
// Progress → migrated to CharacterProgress + ReviewLog (see migrate-progress.ts)
// VocabularyWord, Category, VocabularyList, WordCategory, WordList → replaced by Word model

model FoundationProgress {
  id            String    @id @default(uuid())
  userId        String
  sectionId     String // "pinyin" | "tones" | "strokes" | "animations"
  completed     Boolean   @default(false)
  completedAt   DateTime?
  viewedCount   Int       @default(0)
  firstViewedAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([userId, sectionId])
  @@index([userId])
}

model RadicalProgress {
  id               String    @id @default(uuid())
  userId           String
  radicalId        String // "rad_0001", "rad_0002", etc.
  memorized        Boolean   @default(false)
  recognitionLevel Int       @default(0)
  viewedCount      Int       @default(0)
  firstViewedAt    DateTime?
  reviewedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@unique([userId, radicalId])
  @@index([userId])
}

model CharacterRadical {
  id                Int      @id @default(autoincrement())
  characterGlyph    String // The character glyph, e.g. "路" (kept for backward compat; use characterId going forward)
  characterId       String? // FK to Character.id — nullable for Phase A, will be made required in Phase B
  radicalId         String // The radical ID, e.g. "rad_0034" (references Kangxi radical ID from content/radicals/)
  decompositionType String? // "semantic" | "phonetic" | "remaining" | null
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  character Character? @relation(fields: [characterId], references: [id])
  // Defensive nullable FK — Radical is seeded BEFORE CharacterRadical (seed step 2 < step 17),
  // and every CharacterRadical.radicalId maps to one of the 20 curated radicals.
  radical   Radical?   @relation(fields: [radicalId], references: [id])

  @@unique([characterGlyph, radicalId])
  @@unique([characterId, radicalId])
  @@index([characterGlyph])
  @@index([characterId])
  @@index([radicalId])
}

// ═══════════════════════════════════════════════════════════════════════════
// Reference Tables (Epic 21 WS1) — all-in-DB for radicals / tones / pinyin
// ═══════════════════════════════════════════════════════════════════════════
// Seeded from content/seed/phase2/{radicals,tones,pinyin-phonemes,tone-pairs,
// tone-rules}.json via prisma/seed.ts. These replace runtime reads of
// content/radicals/radicals.json, content/tones/tones.json,
// content/pinyin/pinyin.json and content/references/tone-reference.json.
// All-in-DB is now canonical — the legacy file reads are removed from src/.

// ── Radical: Kangxi radical reference (20 curated rows) ──
// ID format: "rad_XXXX" (Kangxi index, zero-padded). Business-key PK.
model Radical {
  id               String   @id // "rad_0001"
  glyph            String   @unique
  alternateGlyphs  String[] @default([])
  namePinyin       String
  nameChinese      String? // null-normalized (source used "" for absent names)
  meaning          String
  strokeCount      Int
  isRecommended    Boolean  @default(false)
  kangxiIndex      Int?
  etymology        String?
  frequencyRank    Int?
  notes            String?
  isAlsoCharacter  Boolean?
  variants         Json?
  characterRadicals CharacterRadical[]
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([kangxiIndex])
  @@index([isRecommended])
}

// ── Tone: Mandarin tone reference (5 rows: tn_0..tn_4) ──
model Tone {
  id                 String  @id // "tn_0"
  number             Int     @unique
  name               String
  mark               String
  contour            Json
  pitchDescription   String
  exampleSyllable    String?
  exampleCharacter   String?
  color              String?
  pronunciationGuide String?
  commonIssues       String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([number])
}

// ── PinyinPhoneme: initials + finals reference (50 rows) ──
// Initials: 18, Finals: 32. Rows carry phonemeType ("initial" | "final").
model PinyinPhoneme {
  id                 String  @id // "init_b" | "fin_a"
  pinyin             String
  phonemeType        String // "initial" | "final"
  type               String?
  category           String?
  ipa                String?
  description        String?
  mouthPosition      String?
  voiced             Boolean?
  aspirated          Boolean?
  toneVariants       Json?
  pronunciationGuide String?
  commonIssues       String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([phonemeType, pinyin])
  @@index([phonemeType])
}

// ── TonePair: tone-sandhi example word pairs ──
// From content/references/tone-reference.json "tonePairs" (6 rows).
model TonePair {
  id               String   @id // "pair-1"
  chinese          String
  dictionaryPinyin String
  spokenPinyin     String
  rule             String
  pattern          String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

// ── ToneRule: tone-sandhi rules ──
// From content/references/tone-reference.json "toneRules" (3 rows).
// `examples` is a nested array of {chinese, dictionary, spoken} — stored as
// Json (single-row-per-rule; a junction table would be overkill for 3 rules).
model ToneRule {
  id        String   @id // "rule-3rd-sandhi"
  title     String
  rule      String
  examples  Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ── Character: Unified character aggregate ──
// Seeded from content/characters/*.json files.
// Replaces ad-hoc JSON file scanning for character detail API.
// Phase A: Additive — old fields kept for backward compat, new fields + relations added.
model Character {
  id                  String   @id // "ch_1001"
  glyph               String   @unique // "好"
  traditional         String? // null if same as glyph
  strokeCount         Int // 6
  classification      String? // "pictograph" | "ideograph" | "phono_semantic" | "compound_ideograph" | null
  phoneticComponentId String? // References another Character that provides the sound hint
  hskLevel            Int? // 1-6
  frequencyRank       Int? // e.g. 22
  definition          String? // Core meaning from primary reading's gloss
  readings            Json     @default("[]") // [{pinyin, tone, type, meaning}]
  etymology           String? // Story of character origin
  commonWords         String[] @default([]) // ["很好", "爱好"]
  content_version     Int      @default(1)
  metadata            Json? // Flexible metadata from content/characters/*.json
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  // Phase A relations (additive)
  characterReadings      CharacterReading[]
  characterProgress      CharacterProgress[]
  wordCharacters         WordCharacter[]
  hskLevels              CharacterHskLevel[]
  wordStudyContext       WordStudyContext[]
  radicals               CharacterRadical[]
  pinyinMappings         PinyinCharacterMapping[]
  characterComponents    CharacterComponent[]
  phoneticClusterMembers PhoneticClusterMember[]

  // Self-referential phonetic component relation
  phoneticComponent Character?  @relation("PhoneticComponent", fields: [phoneticComponentId], references: [id])
  phoneticChildren  Character[] @relation("PhoneticComponent")

  @@index([glyph])
  @@index([strokeCount])
  @@index([classification])
  @@index([phoneticComponentId])
  @@index([hskLevel])
}

model PhaseGate {
  id                 String   @id @default(uuid())
  userId             String   @unique
  currentPhase       Int      @default(1)
  phase1Passed       Boolean  @default(false)
  phase2Passed       Boolean  @default(false)
  phase3Passed       Boolean  @default(false)
  phase4Unlocked     Boolean  @default(false)
  qualificationScore Int? // Placement quiz score
  placedPhase        Int? // Phase assigned by qualification
  phase1Retention    Float? // Retention rate for phase 1
  phase2Retention    Float? // Retention rate for phase 2
  phase3Retention    Float? // Retention rate for phase 3
  gateCriteria       String? // "quiz" | "retention" | "both"
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([userId])
}

// ── PinyinCombination: init × fin × tone → syllable + character mapping ──
// Content source: content/pinyin/init_*.json + content/pinyin/fin_*.json
// Domain columns: tone (int), syllable (string), character (string?), meaning (string?)
// This is a junction table for the M:N relationship between pinyin initials,
// finals, and tones — not a content entity itself.
model QuizAttempt {
  id          String    @id @default(uuid())
  userId      String
  quizType    String // "audio-to-type" | "comprehension" | "qualification" | ...
  phase       Int? // 1 | 2 | 3 | 0 (qualification)
  totalScore  Int       @default(0)
  maxScore    Int       @default(20)
  passed      Boolean   @default(false)
  passageId   String?  // Links comprehension quizzes to passages.
                       // No @@index needed — queries filter by [userId, quizType] first.
  metadata    Json?
  createdAt   DateTime  @default(now())
  completedAt DateTime?

  answers QuizAttemptAnswer[]

  @@index([userId, quizType])
  @@index([userId])
}

model QuizAttemptAnswer {
  id            String  @id @default(uuid())
  attemptId     String
  questionIndex Int
  pinyinInput   String
  selectedTone  Int
  correctPinyin String
  correctTone   Int
  correct       Boolean
  category      String

  attempt QuizAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  @@index([attemptId])
}

model StudyStreak {
  id               String   @id @default(uuid())
  userId           String   @unique
  currentStreak    Int      @default(0)
  longestStreak    Int      @default(0)
  lastActivityDate DateTime @default(now())
  freezeCount      Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([userId])
}

// ── ReviewItem: Phase 1 review tracking (flip-card SRS) ──
// Tracks study progress for pinyin, tones, stroke reference, and vocabulary items.
// Uses simple interval doubling (not full SM-2) — Phase 1 is introductory.
model ReviewItem {
  id            String    @id @default(uuid())
  userId        String
  itemType      String // "pinyin-initial" | "pinyin-final" | "pinyin-combination" | "tone-identification" | "tone-pair" | "tone-rule" | "stroke-reference" | "pinyin-syllable" | "tone-syllable" | "vocabulary"
  itemId        String // identifier within the type (e.g., "b", "ao", "mā", "3rd+3rd")
  front         String? // Display text for the front of the flip-card
  back          String? // Display text for the back of the flip-card (answer)
  category      String? // Grouping category: "pinyin" | "tones" | "strokes"
  character     String? // Chinese character for vocabulary items
  pinyinPlain   String? // Pinyin without tone marks
  correctTone   Int? // Correct tone number (0-4)
  meaning       String? // English meaning
  studyCount    Int       @default(0)
  correctCount  Int       @default(0)
  lastReviewed  DateTime?
  nextReview    DateTime  @default(now())
  intervalDays  Int       @default(1)
  phaseId       Int       @default(1)
  source        String    @default("viewed")
  viewedCount   Int       @default(0)
  firstViewedAt DateTime?
  lastViewedAt  DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([userId, itemType, itemId])
  @@index([userId, nextReview])
  @@index([userId, phaseId])
  @@index([userId, source])
}

model MnemonicStory {
  id             String   @id @default(uuid())
  characterGlyph String
  userId         String?
  story          String
  radicalIds     Json     @default("[]")
  isEdited       Boolean  @default(false)
  isPictograph   Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([characterGlyph, userId])
  @@index([characterGlyph])
  @@index([userId])
}

// ═══════════════════════════════════════════════════════════════════════════
// Epic 21: Graded Readers — Data Lifecycle Models (Phase A — Additive)
// ═══════════════════════════════════════════════════════════════════════════

// ── Word: Commonly-queried fields in DB ──
// ID format: "w_XXXXX" where XXXXX is a zero-padded integer.
// Stores frequently accessed fields directly for fast queries.
// content/words/words.json is seed source only — never read at runtime.
model Word {
  id            String  @id // "w_00001"
  simplified    String? // Indexed — commonly queried; null until seed populates it
  pinyin        String? // Pinyin with tone marks
  meaning       String? // English meaning(s)
  hskLevel      Int? // Direct HSK level for fast filtering
  frequencyRank Int? // Corpus frequency rank
  wordClass     String? // POS tag: "noun", "verb", etc.

  wordCharacters   WordCharacter[]
  wordHskLevels    WordHskLevel[]
  wordStudyContext WordStudyContext[]
  wordLookupEvents WordLookupEvent[]
  measureWordWords MeasureWordWord[]
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@index([simplified])
  @@index([hskLevel])
  @@index([frequencyRank])
}

// ── WordHskLevel: Which HSK level(s) a word belongs to ──
model WordHskLevel {
  wordId     String
  hskLevel   Int
  hskVersion String?

  word Word @relation(fields: [wordId], references: [id], onDelete: Cascade)

  @@id([wordId])
  @@index([hskLevel])
}

// ── CharacterHskLevel: HSK level assignment for characters ──
model CharacterHskLevel {
  characterId String
  hskLevel    Int

  character Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@id([characterId])
  @@index([hskLevel])
}

// ── WordCharacter: Junction — which characters make up a word ──
model WordCharacter {
  id            String @id @default(uuid())
  wordId        String
  characterId   String
  sequenceOrder Int

  word      Word      @relation(fields: [wordId], references: [id], onDelete: Cascade)
  character Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@unique([wordId, characterId])
  @@index([characterId])
}

// ── CharacterReading: Individual readings (pinyin + tone) for a character ──
model CharacterReading {
  id          String  @id @default(uuid())
  characterId String
  pinyin      String
  tone        Int
  type        String? // "primary" | "secondary"
  commonality Int?

  character Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@index([characterId])
}

// ── CharacterProgress: Per-user SRS progress for individual characters ──
model CharacterProgress {
  id              String    @id @default(uuid())
  userId          String
  characterId     String
  content_version Int       @default(1)
  studyCount      Int       @default(0)
  correctCount    Int       @default(0)
  confidence      Float     @default(0)
  nextReview      DateTime?
  currentDelay    Int?
  lapseCount      Int       @default(0)

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  character Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@unique([userId, characterId])
  @@index([userId])
  @@index([characterId])
}

// ── WordStudyContext: Records which words a user studied within a character context ──
model WordStudyContext {
  id          String   @id @default(uuid())
  userId      String
  characterId String
  wordId      String
  studiedAt   DateTime @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  character Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  word      Word      @relation(fields: [wordId], references: [id], onDelete: Cascade)

  @@index([userId, characterId])
}

// ── ReviewLog: Append-only event log for all review events ──
model ReviewLog {
  id              String   @id @default(uuid())
  userId          String
  itemType        String // "character" | "chengyu" | "radical" | "word"
  itemId          String
  content_version Int      @default(1)
  rating          String // "again" | "good" | "easy"
  source          String? // "quiz_failure" | "review" | "viewed"
  timestamp       DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, itemType, timestamp])
}

// ── WordLookupEvent: Tracks word lookup activity (guest users via sessionId) ──
model WordLookupEvent {
  id        String   @id @default(uuid())
  userId    String?
  sessionId String
  wordId    String
  passageId String?
  timestamp DateTime @default(now())

  word    Word     @relation(fields: [wordId], references: [id], onDelete: Cascade)
  passage Passage? @relation("PassageLookups", fields: [passageId], references: [id])

  @@index([userId])
  @@index([sessionId])
  @@index([wordId])
  @@index([timestamp])
}

// ── Passage: Graded reading passage ──
// Content stored as JSON: { sentences: [...], metadata: {...} }
model Passage {
  id             String    @id @default(uuid())
  hskLevel       Int
  passageIndex   Int
  title          String
  content        Json // { sentences: [...], metadata: {...} }
  wordCount      Int
  knownWordRatio Float
  targetHskLevel Int
  generatedById  String?
  generatedAt    DateTime  @default(now())
  accessCount    Int       @default(0)
  lastAccessedAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  readingSessions ReadingSession[]
  bookmarks       Bookmark[]
  lookupEvents    WordLookupEvent[] @relation("PassageLookups")

  @@unique([hskLevel, passageIndex])
  @@index([hskLevel])
  @@index([lastAccessedAt])
}

// ── ReadingSession: Tracks a user's reading progress through a passage ──
model ReadingSession {
  id              String    @id @default(uuid())
  userId          String
  passageId       String
  currentSentence Int       @default(0)
  completed       Boolean   @default(false)
  startedAt       DateTime  @default(now())
  completedAt     DateTime?
  lastAccessedAt  DateTime  @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  passage Passage @relation(fields: [passageId], references: [id], onDelete: Cascade)

  @@unique([userId, passageId])
  @@index([userId])
}

// ── Bookmark: Saved passages for later reading ──
model Bookmark {
  id        String   @id @default(uuid())
  userId    String
  passageId String
  note      String?
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  passage Passage @relation(fields: [passageId], references: [id], onDelete: Cascade)

  @@unique([userId, passageId])
  @@index([userId])
}

// ═══════════════════════════════════════════════════════════════════════════
// Phase A — New Models (additive)
// ═══════════════════════════════════════════════════════════════════════════

// ── PinyinSyllable: Canonical pinyin syllable reference ──
// Seeded from content/pinyin/init_*.json + fin_*.json data.
// Represents every valid (initial × final × tone) combination in standard Mandarin.
model PinyinSyllable {
  id             String   @id // e.g., "b_a_1" — composite key pattern
  initial        String? // e.g., "b", "p", "m", "f" — null for zero-initial
  final          String? // e.g., "a", "o", "e", "i"
  tone           Int // 1-5 (5 = neutral)
  syllable       String // Full pinyin with tone number, e.g., "ma1"
  syllablePretty String // Full pinyin with tone mark, e.g., "mā"
  isStandard     Boolean  @default(true) // part of standard Mandarin inventory
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  characterMappings PinyinCharacterMapping[]

  @@unique([initial, final, tone])
  @@index([syllable])
  @@map("PinyinSyllable")
}

// ── PinyinCharacterMapping: Links pinyin syllables to character readings ──
model PinyinCharacterMapping {
  id               String   @id @default(uuid())
  pinyinSyllableId String
  characterId      String
  readingType      String   @default("primary") // "primary" | "literary" | "colloquial" | "variant"
  isDefault        Boolean  @default(false) // Is this the default reading for this character?
  createdAt        DateTime @default(now())

  pinyinSyllable PinyinSyllable @relation(fields: [pinyinSyllableId], references: [id])
  character      Character      @relation(fields: [characterId], references: [id])

  @@unique([pinyinSyllableId, characterId, readingType])
  @@index([characterId])
  @@map("PinyinCharacterMapping")
}

// ── MeasureWord: Measure word (量词) entity ──
// ID format: "mw_XXXXX" where XXXXX is a zero-padded integer.
model MeasureWord {
  id         String            @id // "mw_00001"
  simplified String            @unique // "个", "条", "张"
  pinyin     String? // "gè", "tiáo", "zhāng"
  meaning    String? // "general individual", "for long slender objects"
  category   String? // "measure", "time", "abstract", "verb", "formal"
  usageNote  String? // "Used for people, general objects"
  nouns      MeasureWordWord[]
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  @@index([category])
  @@map("MeasureWord")
}

// ── MeasureWordWord: Measure word ↔ Word (noun) junction ──
// Pairs a measure word with the nouns it modifies.
model MeasureWordWord {
  id              String      @id @default(uuid())
  measureWordId   String
  wordId          String // "w_00001" — FK to Word table (noun)
  exampleSentence String? // "一个人" — illustrative example
  isDefault       Boolean     @default(false) // true if this is the default MW for this noun
  measureWord     MeasureWord @relation(fields: [measureWordId], references: [id])
  word            Word        @relation(fields: [wordId], references: [id])

  @@unique([measureWordId, wordId])
  @@index([wordId])
  @@index([measureWordId])
  @@map("MeasureWordWord")
}

// ── Component: Reusable sub-character component ──
// Represents a structural component that appears inside characters.
// ID format: "cmp_XXX" — zero-padded integer.
model Component {
  id               String               @id // "cmp_001"
  glyph            String               @unique // "氵", "口", "青", "可"
  meaning          String? // "water", "mouth", "blue/green", "able"
  type             String? // "radical" | "phonetic" | "both"
  variantOf        String? // References another Component ID (e.g., 氵 is variant of 水)
  strokes          Int? // Stroke count for this component
  characters       CharacterComponent[]
  phoneticClusters PhoneticCluster[]
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  @@index([type])
  @@index([variantOf])
  @@map("Component")
}

// ── CharacterComponent: Character ↔ Component decomposition junction ──
// Links a character to its constituent components with positional info.
model CharacterComponent {
  id          String    @id @default(uuid())
  characterId String // FK to Character.id
  componentId String // FK to Component.id
  position    String? // "left" | "right" | "top" | "bottom" | "outside" | "inside" | "center"
  function    String? // "semantic" | "phonetic" | "remaining"
  character   Character @relation(fields: [characterId], references: [id])
  component   Component @relation(fields: [componentId], references: [id])

  @@unique([characterId, componentId])
  @@index([characterId])
  @@index([componentId])
  @@index([function])
  @@map("CharacterComponent")
}

// ═══════════════════════════════════════════════════════════════════════════
// Story 21.6: Phonetic Clusters
// ═══════════════════════════════════════════════════════════════════════════

// ── PhoneticCluster: Group of characters sharing a phonetic component ──
// E.g., 青 family (请情清晴). Links to Component for the phonetic glyph/pinyin.
model PhoneticCluster {
  id                String   @id @default(cuid())
  componentId       String   @unique // FK → Component.id
  displayOrder      Int
  description       String
  pronunciationNote String?
  phoneticPinyin    String? // Pinyin reading of the phonetic component glyph (e.g., "qīng" for 青)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  component Component               @relation(fields: [componentId], references: [id])
  members   PhoneticClusterMember[]

  @@map("phonetic_clusters")
}

// ── PhoneticClusterMember: A character belonging to a phonetic cluster ──
model PhoneticClusterMember {
  id            String @id @default(uuid())
  clusterId     String // FK → PhoneticCluster.id
  characterId   String // FK → Character.glyph
  sequenceOrder Int

  cluster   PhoneticCluster @relation(fields: [clusterId], references: [id], onDelete: Cascade)
  character Character       @relation(fields: [characterId], references: [glyph])

  @@unique([clusterId, characterId])
  @@map("phonetic_cluster_members")
}

// ═══════════════════════════════════════════════════════════════════════════
// Story 21.13: Stroke Content Foundation — DB-backed stroke pipeline
// ═══════════════════════════════════════════════════════════════════════════

// ── StrokeCategory: 5 PRC base stroke categories ──
model StrokeCategory {
  id            String   @id // "dian" | "heng" | "shu" | "pie" | "zhe"
  name          String   // "点"
  pinyin        String   // "diǎn"
  meaning       String   // "dot"
  glyph         String?  // Stroke glyph character (丶, 一, 丨, 丿, ㇍)
  order         Int      // Display order (1-5)
  strokeCount   Int      @default(1)
  exampleChars  String[] // ["主", "州", "为", "头"]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  extendedTypes  StrokeExtendedType[]
  categoryRules  StrokeCategoryOrderRule[]
}

model StrokeExtendedType {
  id              String   @id // "na" | "ti" | "wan" | "gou" | ...
  name            String   // "捺"
  pinyin          String   // "nà"
  meaning         String   // "right-falling"
  glyph           String?  // Stroke glyph character (㇏, ㇀, 亅, etc.)
  baseCategoryId  String   // FK → StrokeCategory.id
  order           Int
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  baseCategory    StrokeCategory @relation(fields: [baseCategoryId], references: [id])
  @@index([baseCategoryId])
}

model StrokeOrderRule {
  id              String   @id // "rule-1" | "rule-2" | ...
  number          Int      @unique // 1-5
  name            String   // "Top to Bottom"
  description     String   // "Write strokes from top to bottom"
  examples        String[] // ["三", "王", "立", "章"]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  categoryRules   StrokeCategoryOrderRule[]
}

model StrokeCategoryOrderRule {
  id              String   @id @default(uuid())
  categoryId      String   // FK → StrokeCategory.id
  ruleId          String   // FK → StrokeOrderRule.id
  priority        Int      @default(0)
  createdAt       DateTime @default(now())
  category        StrokeCategory @relation(fields: [categoryId], references: [id])
  rule            StrokeOrderRule @relation(fields: [ruleId], references: [id])
  @@unique([categoryId, ruleId])
  @@index([categoryId])
  @@index([ruleId])
}
